# Protects the dashboard and admin API with a single login. Leave both blank to
# run without a login (only do that behind your own proxy/VPN). Password: 8+ characters.
UMAGO_ADMIN_USER=admin
UMAGO_ADMIN_PASSWORD=change-me-please

# SQLite (default backend) database file inside the container.
UMAGO_DATABASE_PATH=/data/umago.db

# Set this to use Postgres instead (UMAGO_DATABASE_PATH is then ignored):
# UMAGO_DATABASE_URL=postgres://umago:umago@postgres:5432/umago?sslmode=disable
# Password for the Postgres container in docker-compose.postgres.yml.
# POSTGRES_PASSWORD=umago

# Days of raw events to keep (minimum 2). Hourly and daily rollups are kept forever.
UMAGO_RETENTION_DAYS=7

UMAGO_LOG_LEVEL=info

# Bearer token for the read-only MCP endpoint (/mcp) that AI agents connect to.
# 16+ characters; leave blank to allow only the admin login there.
UMAGO_MCP_TOKEN=

# OAuth client from Google Cloud for the per-site "Connect Google Search Console"
# button. Register <your umago url>/api/v1/google/callback as the redirect URI.
UMAGO_GOOGLE_CLIENT_ID=
UMAGO_GOOGLE_CLIENT_SECRET=

# Comma-separated top-level .js paths the tracking snippet is served from.
# The first entry is the canonical one shown in the dashboard. Use neutral
# names to dodge adblockers, e.g. UMAGO_SCRIPT_NAMES=a.min.js,b.js,stats.js.
# Defaults to umago.js when unset.
# UMAGO_SCRIPT_NAMES=umago.js

# Optional GeoIP location detail (default off: proxy headers + time zones only).
# UMAGO_GEOIP_PATH points at an .mmdb file on disk (DB-IP or MaxMind) and wins
# over the database managed in Settings → Location. UMAGO_GEOIP_MODE pins
# off/country/city, UMAGO_GEOIP_SOURCE pins dbip/maxmind, and
# UMAGO_MAXMIND_LICENSE_KEY supplies the GeoLite2 key for downloads.
# UMAGO_GEOIP_PATH=
# UMAGO_GEOIP_MODE=off
# UMAGO_GEOIP_SOURCE=dbip
# UMAGO_MAXMIND_LICENSE_KEY=
